# Clickroom self-host configuration.
#
# You normally never edit this by hand: install.sh creates .env from it, generates every secret,
# and asks for a domain. Everything below the "Optional" line has a safe default.

CLICKROOM_REGISTRY=ghcr.io/room-co       # image registry prefix
CLICKROOM_VERSION=latest                   # pin e.g. v0.1.0 for production
CLICKROOM_PUBLIC_URL=http://localhost      # the one public origin (scheme + host)
CADDY_SITE_ADDRESS=http://localhost        # domain => automatic HTTPS; http://localhost => plain HTTP

# Generated by install.sh (openssl rand -hex). Never reuse values; back this file up.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_QUERY_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_JWT_SECRET=
SSO_RELAY_STATE_SECRET=
SSO_SECRETS_KEY=
AI_ENCRYPTION_KEY=
MCP_OAUTH_STATE_SECRET=
INTERNAL_QUERY_SECRET=

# Bundled Garage S3 (compose profile `storage`). GARAGE_* are 32-byte hex; the access key id is
# "GK" + 24 hex chars and the secret 64 hex chars (Garage's key format). Also used as the S3
# credentials capture presigns with (override with real S3 credentials for an external bucket).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Optional (defaults shown) ──────────────────────────────────────────────
# HTTP_PORT=80
# HTTPS_PORT=443
# CADDY_TRUSTED_PROXIES=             # behind Cloudflare/another proxy: its CIDRs, space-separated, so real client IPs are used
# SIGNUP_MODE=first_user_only        # open | first_user_only | closed
# ADMIN_PASSWORD_SINK=stdout         # stdout | ssm | env
# QUOTA_ENFORCE=false
# CLICKROOM_WRITE_KEY=               # dashboard self-analytics; empty = off, nothing phones home
# CLICKROOM_ADMIN_EMAIL=             # first-boot admin (prefer: docker compose run --rm cli pnpm admin:create)
# CLICKROOM_ADMIN_PASSWORD=
# CAPTURE_STREAM_MAX_BYTES=16106127360

# Admin console (off by default). Enable with: install.sh --with-admin  (sets COMPOSE_PROFILES=admin,
# ADMIN_SITE_ADDRESS=admin.<domain>, ADMIN_PUBLIC_URL; you need a DNS record for admin.<domain>).

# Support-ticket attachments (off by default). Enable the bundled Garage S3 with:
#   install.sh --with-storage     (writes everything below and sets COMPOSE_PROFILES=storage)
# or by hand: COMPOSE_PROFILES=storage plus the four generated values above and:
# S3_BUCKET=clickroom-attachments
# SUPPORT_ATTACHMENTS_BUCKET=clickroom-attachments
# S3_ENDPOINT=http://garage:3900
# S3_PUBLIC_ENDPOINT=${CLICKROOM_PUBLIC_URL}   # browser-reachable; Caddy routes /<bucket>/* to Garage
# AWS_REGION=us-east-1                         # must match s3_region in garage/garage.toml
# S3_FORCE_PATH_STYLE=true                     # (default) Garage is addressed path-style
# Or point these at any external S3 (and set S3_FORCE_PATH_STYLE=false for AWS).
