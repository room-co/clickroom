# clickroom e2e environment — sourced by scripts/e2e-up.sh / scripts/e2e-down.sh,
# and (follow-up) by Playwright global-setup / test helpers via dotenv.
#
# Reuses the SAME docker containers as dev (postgres/clickhouse/nats/redis —
# see docker-compose.yml) but isolated logical resources (separate DB names,
# NATS stream/subjects, alt service ports) so `make up:e2e` can run alongside
# a running `make up` dev stack with zero data cross-contamination.
#
# See apps/web/e2e/README.md for the full isolation model.

# Dev-literal secret fallbacks (JWT_SECRET etc.) are ONLY usable when NODE_ENV is development/test.
NODE_ENV=development

# ── Postgres (shared clickroom-postgres container, isolated DB) ────────────
DATABASE_URL=postgresql://clickroom:clickroom@localhost:5433/clickroom_e2e?schema=public

# ── ClickHouse (shared clickroom-clickhouse container, isolated DB) ────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=clickroom
CLICKHOUSE_PASSWORD=clickroom
CLICKHOUSE_DATABASE=clickroom_e2e

# ── NATS JetStream (shared clickroom-nats container, isolated stream) ──────
# Stream/subject/durable names are env-driven (services/capture/src/config.rs,
# services/ingest/src/config.rs) so dev ingest never sees e2e messages and
# vice-versa — no competing-consumer split, no cross-writes.
NATS_URL=nats://localhost:4222
CAPTURE_STREAM_NAME=EVENTS_E2E
CAPTURE_SUBJECT_PREFIX=e2e.events.raw
INGEST_STREAM_NAME=EVENTS_E2E
INGEST_SUBJECT_FILTER="e2e.events.raw.>"
INGEST_DURABLE_NAME=ingest-e2e
INGEST_DLQ_SUBJECT_PREFIX=e2e.events.dlq
INGEST_DLQ_STREAM_NAME=EVENTS_E2E_DLQ
# Fast flush so the ClickHouse-poll test helper doesn't wait on batching.
INGEST_BATCH_MAX_SIZE=1
INGEST_BATCH_MAX_WAIT_MS=50

# ── Rust query (services/query) / SQL Explorer — tenant-scoped read-only ───
# Alt port so e2e coexists with dev's :3002. apps/api's e2e instance (see
# API_PORT below) is pointed at this via QUERY_SERVICE_URL so its
# sqlExplorer.run mutation reaches the e2e query service, not dev's.
QUERY_PORT=3102
QUERY_SERVICE_URL=http://localhost:3102
# Throwaway e2e-only secret — doesn't need to match dev's INTERNAL_QUERY_SECRET.
INTERNAL_QUERY_SECRET=e2e-internal-query-secret
CLICKHOUSE_QUERY_USER=clickroom_query
# ClickHouse users are global (not per-database), and migration 007's
# `CREATE USER IF NOT EXISTS` is a no-op once `clickroom_query` exists from a
# prior dev `make infra:up` run — so this MUST match dev's
# CLICKHOUSE_QUERY_PASSWORD (.env's dev default is `clickroom_query_dev`,
# packages/clickhouse/src/migrate.ts's ENV_TOKEN_DEV_DEFAULTS) rather than
# picking an independent e2e-only value, or the e2e query service's login
# fails with AUTHENTICATION_FAILED against the already-created global user.
CLICKHOUSE_QUERY_PASSWORD=clickroom_query_dev

# ── Redis (shared clickroom-redis container) ───────────────────────────────
# No isolation needed: keys are org/project/hash-scoped (capture:key:<hash>,
# capture:schema:<project_id>, flag/usage caches) — unique e2e org/project
# ids + distinct key hashes isolate them from dev data.
REDIS_URL=redis://localhost:6380

# ── Usage / quotas ──────────────────────────────────────────────────────────
QUOTA_ENFORCE=true

# ── Service ports (alt ports so e2e coexists with a running `make up`) ─────
# dev: api :3000 · capture :3001 · web :5180 — e2e uses the block below.
CAPTURE_PORT=3101
API_PORT=3100
WEB_PORT=5273
VITE_API_PROXY_TARGET=http://localhost:3100

# ── Auth (packages/auth) ────────────────────────────────────────────────────
# Reuses the SAME value as dev's root .env (see JWT_SECRET in .env /
# .env.example) — not a real secret boundary for local e2e, it just needs to
# match what packages/auth's JWT verification expects for tokens minted by
# apps/api to validate.
JWT_SECRET=dev-only-change-me

# ── e2e seed identities (packages/db/src/seed.e2e.ts) ──────────────────────
# Fixed test-key plaintexts + creds so specs don't need a fresh seed each run
# (deterministic keys resolved by upsert-on-keyHash in seed.e2e.ts). Throwaway
# values, local-only, not real secrets.
E2E_WRITE_KEY=ckw_live_a2987d751bd5c7ed4c7d9d603a1dc1b5fb910a5fd82cce3d
E2E_READ_KEY=ckr_live_e2e0000000000000000000000000000000000000000
E2E_LIMITED_WRITE_KEY=ckw_live_e2elimited00000000000000000000000000000000000
E2E_USER_EMAIL=e2e@clickroom.dev
E2E_USER_PASSWORD=e2e-test-pw-2026
